{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Issuer - JSON",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/WebApi.Issuer/bin/Debug/net10.0/WebApi.Issuer.dll",
      "cwd": "${workspaceFolder}/src/WebApi.Issuer",
      "justMyCode": true,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "https://.*:5003",
        "uriFormat": "https://localhost:5003/"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://+:5003",
        "ASPNETCORE_Kestrel__Certificates__Default__Path": "./runtime/secrets/hosting-cert.crt",
        "ASPNETCORE_Kestrel__Certificates__Default__KeyPath": "./runtime/secrets/hosting-key.pem",
        "TOKEN_LIFETIME_MINUTES": "30",
        "SECRET_PATH": "./runtime/secrets/",
        "Persistence__Mode": "json",
        "DATA_PATH": "./runtime/data/",
        "Logging__LogLevel__Default": "Warning",
        "Logging__LogLevel__WebApi": "Information",
        "Logging__Console__FormatterName": "simple",
        "Logging__Console__FormatterOptions__IncludeTimestamp": "true",
        "Logging__Console__FormatterOptions__TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
      },
      "presentation": {
        "hidden": true
      }
    },
