{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rebuild-sln",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "msbuild",
        "${workspaceFolder}/src/WebApi.sln",
        "/t:Rebuild",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "_publish-local-issuer",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "args": [
        "publish",
        "WebApi.Issuer/WebApi.Issuer.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "_publish-local-api",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "args": [
        "publish",
        "WebApi.Service/WebApi.Service.csproj",
        "-c",
        "Release"
      ],
      "dependsOn": [
        "_publish-local-issuer"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "_publish-local-client",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "args": [
        "publish",
        "WebApi.Client/WebApi.Client.csproj",
        "-c",
        "Release"
      ],
      "dependsOn": [
        "_publish-local-api"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-local",
      "dependsOn": [
        "_publish-local-client"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "_publish-container-issuer",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "args": [
        "publish",
        "WebApi.Issuer/WebApi.Issuer.csproj",
        "-c",
        "Release",
        "-p:IsContainerBuild=true"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "_publish-container-api",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "args": [
        "publish",
        "WebApi.Service/WebApi.Service.csproj",
        "-c",
        "Release",
        "-p:IsContainerBuild=true"
      ],
      "dependsOn": [
        "_publish-container-issuer"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "_publish-container-client",
      "type": "shell",
      "command": "dotnet",
      "options": {
        "cwd": "${workspaceFolder}/src"
      },
      "args": [
        "publish",
        "WebApi.Client/WebApi.Client.csproj",
        "-c",
        "Release",
        "-p:IsContainerBuild=true"
      ],
      "dependsOn": [
        "_publish-container-api"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-container",
      "dependsOn": [
        "_publish-container-client"
      ],
      "problemMatcher": [],
      "group": "build"
    }
  ]
}