{
  "profiles": {
    "Issuer (Development)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:5003",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://+:5003",
        "ASPNETCORE_Kestrel__Certificates__Default__Path": "./assets/https/cert.crt",
        "ASPNETCORE_Kestrel__Certificates__Default__KeyPath": "./assets/https/key.pem",
        "ISSUER_BASE_URL": "https://localhost:5003/connect",
        "TOKEN_LIFETIME_MINUTES": "30",
        "Logging__Console__FormatterName": "simple",
        "Logging__Console__FormatterOptions__IncludeTimestamp": "true",
        "Logging__Console__FormatterOptions__TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
      }
    }
  }
}