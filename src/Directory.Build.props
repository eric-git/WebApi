<Project>

  <!-- Assembly identity & metadata -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Product>Sample Web API Suite</Product>
    <Company>Project ERIC</Company>
    <Copyright>© 2025 Project ERIC. All rights reserved.</Copyright>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\web-api-suite.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Metadata -->
  <PropertyGroup>
    <ProjectContactName>Eric Wu</ProjectContactName>
    <ProjectContactEmail>wu_yuqing@hotmail.com</ProjectContactEmail>
    <ProjectContactUrl>https://github.com/eric-git/WebApi</ProjectContactUrl>
    <ProjectLicenseName>MIT</ProjectLicenseName>
    <ProjectLicenseUrl>https://github.com/eric-git/WebApi?tab=MIT-1-ov-file</ProjectLicenseUrl>
    <ProjectTermsUrl>https://github.com/eric-git/WebApi?tab=security-ov-file</ProjectTermsUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectContactName</_Parameter1>
      <_Parameter2>$(ProjectContactName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectContactEmail</_Parameter1>
      <_Parameter2>$(ProjectContactEmail)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectContactUrl</_Parameter1>
      <_Parameter2>$(ProjectContactUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectLicenseName</_Parameter1>
      <_Parameter2>$(ProjectLicenseName)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectLicenseUrl</_Parameter1>
      <_Parameter2>$(ProjectLicenseUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectTermsUrl</_Parameter1>
      <_Parameter2>$(ProjectTermsUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- CI -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' AND ('$(GITHUB_ACTIONS)'=='true' OR '$(TF_BUILD)'=='True')">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Language & globalization -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-AU</NeutralLanguage>
    <PreferredUILang>en-AU</PreferredUILang>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Code analysis -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Release configuration -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Publish output -->
  <PropertyGroup>
    <PublishRoot>$(SolutionDir)publish</PublishRoot>
    <IsContainerBuild Condition="'$(IsContainerBuild)'==''">false</IsContainerBuild>
    <PublishFlavor Condition="'$(IsContainerBuild)'=='true'">container</PublishFlavor>
    <PublishFlavor Condition="'$(IsContainerBuild)'!='true'">local</PublishFlavor>
    <PublishDir>$(PublishRoot)/$(PublishFlavor)/</PublishDir>
  </PropertyGroup>

  <!-- Runtime asset paths -->
  <PropertyGroup>
    <AssetRoot>$(MSBuildProjectDirectory)/runtime</AssetRoot>
    <SecretStoreRoot>$(AssetRoot)/secrets</SecretStoreRoot>
    <DataStoreRoot>$(AssetRoot)/data</DataStoreRoot>
  </PropertyGroup>

</Project>