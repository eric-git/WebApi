<Project>

  <!-- Discover asset files -->
  <ItemGroup Condition="Exists('$(SecretStoreRoot)')">
    <AssetFiles Include="$(SecretStoreRoot)/**/*">
      <Link>secrets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AssetFiles>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(DataStoreRoot)')">
    <AssetFiles Include="$(DataStoreRoot)/**/*">
      <Link>data\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AssetFiles>
  </ItemGroup>

  <!-- Example static file -->
  <ItemGroup>
    <None Update="favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Exclude asset directories during container builds -->
  <ItemGroup>
    <ExcludedAssetDirs Include="$(SecretStoreRoot)" Condition="'$(IsContainerBuild)'=='true'" />
    <ExcludedAssetDirs Include="$(DataStoreRoot)" Condition="'$(IsContainerBuild)'=='true'" />
    <AssetFiles Remove="@(ExcludedAssetDirs->'%(FullPath)/**/*')" Condition="'@(ExcludedAssetDirs)' != ''" />
  </ItemGroup>

  <!-- Copy runtime assets after normal build -->
  <Target Name="CopyRuntimeAfterBuild"
          AfterTargets="Build"
          Condition="'@(AssetFiles)' != ''">
    <Copy SourceFiles="@(AssetFiles)"
          DestinationFiles="@(AssetFiles->'$(OutDir)runtime\%(Link)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy runtime assets after publish -->
  <Target Name="CopyRuntimeAfterPublish"
          AfterTargets="Publish"
          Condition="'@(AssetFiles)' != ''">
    <Copy SourceFiles="@(AssetFiles)"
          DestinationFolder="$(PublishDir)runtime\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Full clean: remove bin/obj -->
  <Target Name="CleanBinObj" AfterTargets="Clean">
    <RemoveDir Directories="$(ProjectDir)bin" />
  </Target>

</Project>