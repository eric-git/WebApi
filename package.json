{
  "name": "web-api-suite",
  "version": "1.0.0",
  "description": "A sample Web API suite project.",
  "author": {
    "name": "Eric Wu",
    "email": "wu_yuqing@hotmail.com",
    "url": "https://github.com/eric-git"
  },
  "type": "module",
  "scripts": {
    "spell-check": "npx cspell **/*",
    "format": "npx prettier --write .",
    "serve-redoc-api": "serve ./src/redoc/WebApi.Service -l 2026",
    "deploy-redoc": "node ./src/redoc/deploy-redoc.mjs",
    "init-local-shell": "sh ./local/ensure-runtime.sh",
    "init-local-pwsh": "pwsh ./local/ensure-runtime.ps1"
  },
  "devDependencies": {
    "@cspell/dict-dotnet": "latest",
    "cspell": "latest",
    "fast-glob": "latest",
    "serve": "latest",
    "prettier": "latest"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "license": "MIT",
  "keywords": [
    "Web API",
    "B2C",
    "Docker",
    "PostgreSQL",
    "Dotnet",
    "Redoc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eric-git/WebApi"
  }
}
